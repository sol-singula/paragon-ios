// Copy to Secrets.xcconfig and fill in. That file is gitignored.
//
// The anon key is the publishable key: it already ships in the website and
// the desktop app and is safe in a client. It is kept out of git so the app
// can be pointed at another project without a commit.
//
// Note the escaped slashes: xcconfig treats // as a comment, even inside a value.

SUPABASE_URL = https:/$()/kvedatksqkcsgivntskb.supabase.co
SUPABASE_ANON_KEY = your-anon-key

// Optional: your Apple team, so Xcode signs without asking.
// DEVELOPMENT_TEAM = ABCDE12345
